int main()
[
    bool fact1 = true || false && false;    $ должно быть true
    output("fact1 = ", fact1);

    bool fact2 = (true || false) && false;  $ должно быть false
    output("fact2 = ", fact2);

    bool fact3 = !true && false;            $ должно быть false
    output("fact3 = ", fact3);

    bool fact4 = !(true && false);          $ должно быть true
    output("fact4 = ", fact4);

    $ приоритеты операторов сравнения
    bool fact5 = 5 > 3 && 2 < 4;        $ должно быть true
    output("fact5 = ", fact5);
    
    bool fact6 = 1 <= 3 && 2 == 4;      $ должно быть false
    output("fact6 = ", fact6);
    
    bool fact7 = 5 != 5 || 3 >= 3;      $ должно быть true
    output("fact7 = ", fact7);          $ все операторы сравнения выше, чем && и || (без скобок)
]