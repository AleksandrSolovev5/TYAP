int main()
[
    $ данный тест проверяет, что логическое выражение вычисляется слева направо
    $ и если по левой части можно понять результат, то правая часть отсекается

    bool garbage;
    input(garbage);     $ если надо сломать программу - вводим false

    $ в случае, если garbage == true, мы не дойдем до деления на 0, и программа завершится без ошибок
    bool result = garbage || (1 / 0 == 0);
    output("final destination\n");
]